{
  "typography": {
    "fontFamily": {
      "sans": { "$value": "Inter, Arial, Helvetica, sans-serif", "$type": "fontFamily", "$description": "The font actually rendered in all 5 apps today, applied via a global CSS override rather than Tailwind config. This token is what fixes that — register it as the Tailwind 'sans' default." },
      "mono": { "$value": "'SF Mono', 'Cascadia Code', Consolas, monospace", "$type": "fontFamily", "$description": "New token — no app currently defines a mono stack. Proposed for code/data display." }
    },
    "display-large": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "52px", "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": 700 }, "$type": "typography", "$description": "Source: Figma Typography page. Weight (700) is proposed, not confirmed by a Figma variable — flag for design sign-off." },
    "display-small": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "44px", "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": 700 }, "$type": "typography", "$description": "Weight proposed, not confirmed." },
    "heading-h1": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "40px", "lineHeight": "48px", "letterSpacing": "-0.02em", "fontWeight": 800 }, "$type": "typography", "$description": "Weight proposed by extrapolation from the confirmed H2 weight, not itself confirmed." },
    "heading-h2": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "36px", "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": 800 }, "$type": "typography", "$description": "Confirmed via Figma variable 'Heading/H2/Extrabold/Desktop'." },
    "heading-h3": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "32px", "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": 700 }, "$type": "typography", "$description": "Weight proposed, not confirmed." },
    "heading-h4": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "28px", "lineHeight": "36px", "letterSpacing": "-0.02em", "fontWeight": 500 }, "$type": "typography", "$description": "Confirmed via Figma variable 'Heading/H4/Medium/Desktop'." },
    "heading-h5": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "-0.02em", "fontWeight": 600 }, "$type": "typography", "$description": "Weight proposed, not confirmed." },
    "heading-h6": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "20px", "lineHeight": "28px", "letterSpacing": "-0.02em", "fontWeight": 600 }, "$type": "typography", "$description": "Weight proposed, not confirmed." },
    "paragraph-large-regular": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "18px", "lineHeight": "28px", "letterSpacing": "0", "fontWeight": 400 }, "$type": "typography", "$description": "Confirmed via Figma variable 'Paragraph/Large/Regular'." },
    "paragraph-large-medium": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "18px", "lineHeight": "28px", "letterSpacing": "0", "fontWeight": 500 }, "$type": "typography", "$description": "Confirmed via Figma variable 'Paragraph/Large/Medium'." },
    "paragraph-medium": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0", "fontWeight": 400 }, "$type": "typography", "$description": "Weight proposed, not confirmed." },
    "paragraph-medium-medium": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0", "fontWeight": 500 }, "$type": "typography", "$description": "Confirmed via live Figma design context on the Button component (Size=Large label uses Inter Medium 16/24) — same size as paragraph-medium, Medium weight instead of Regular, same pairing pattern as paragraph-large-regular/medium." },
    "paragraph-small": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0", "fontWeight": 400 }, "$type": "typography", "$description": "Confirmed via live Figma design context on the Input Field component (Box and Line variants both use Inter Regular 14/20 for value/placeholder/helper text)." },
    "paragraph-small-medium": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "14px", "lineHeight": "20px", "letterSpacing": "0", "fontWeight": 500 }, "$type": "typography", "$description": "Confirmed twice via live Figma design context: Button (Size=Medium label) and Input Field (label text) both use Inter Medium 14/20." },
    "paragraph-xsmall": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "12px", "lineHeight": "20px", "letterSpacing": "0", "fontWeight": 400 }, "$type": "typography", "$description": "Weight proposed, not confirmed." },
    "label-xsmall": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "12px", "lineHeight": "15px", "letterSpacing": "0", "fontWeight": 500 }, "$type": "typography", "$description": "Confirmed via live Figma design context on the Button component (Size=Small label). Distinct from paragraph-xsmall: same fontSize but a tighter 15px line-height and Medium weight — genuinely a different style, not a variant of it." },
    "overline": { "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "12px", "lineHeight": "16px", "letterSpacing": "0.04em", "fontWeight": 600 }, "$type": "typography", "$description": "Proposed — Figma had a 14px/12px overline pairing but no bound variable to confirm weight/tracking; uppercase usage assumed at consumption time, not baked into the token." }
  }
}
